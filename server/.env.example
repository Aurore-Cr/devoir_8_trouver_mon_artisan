PORT=5000
NODE_ENV=development

# Base de données MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=trouve_ton_artisan
DB_USER=root
DB_PASSWORD=

# Origine autorisee pour l'acces a l'API (le front, et uniquement lui)
CLIENT_URL=http://localhost:5173

# Envoi d'e-mails (formulaire de contact artisan)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Trouve ton artisan <no-reply@trouve-ton-artisan.fr>"
